---
---

<section class="section-container" id="casos">
  <div class="section-header">
    <div class="badge badge-cyan">Casos de Éxito Reales</div>
    <h2>Resultados que Hablan: <span class="text-gradient-cyan">Crecimiento Medible</span></h2>
    <p>Marcas personales y ejecutivos que transformaron su presencia digital y multiplicaron sus ventas con la estrategia Casanostra.</p>
  </div>

  <div class="case-studies-wrapper glass-panel">
    <div class="case-grid">
      <!-- Image Preview -->
      <div class="case-visual">
        <div class="case-image-container">
          <img 
            src="/images/growth_case_study.jpg" 
            alt="Casos de Crecimiento Casanostra" 
            class="case-img"
            loading="lazy"
          />
          <div class="case-overlay-badge glass-panel">
            <span class="pulse-dot"></span>
            <strong>+500K Seguidores Reales Reivindicados</strong>
          </div>
        </div>
      </div>

      <!-- Case Content Cards / Tabs -->
      <div class="case-details">
        <div class="case-tabs" id="caseTabs">
          <button class="case-tab active" data-case="1">Doctor Alejandro</button>
          <button class="case-tab" data-case="2">Sofía Valenzuela</button>
          <button class="case-tab" data-case="3">Carlos Mendoza</button>
        </div>

        <!-- Case 1 Content -->
        <div class="case-content active" id="case1">
          <div class="case-niche">Sector Salud & Cirugía Estética</div>
          <h3>Dr. Alejandro Vivas - Marca Médica de Autoridad</h3>
          <p class="case-quote">"Pasamos de tener una cuenta vacía de interacción a recibir solicitudes diarias de pacientes internacionales que vienen recomendados por nuestro contenido."</p>

          <div class="case-metrics">
            <div class="metric-card">
              <div class="metric-val text-gradient-gold">+240K</div>
              <div class="metric-lbl">Seguidores Reales</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-cyan">$185,000 USD</div>
              <div class="metric-lbl">Nuevas Consultas / Año</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-purple">14.8%</div>
              <div class="metric-lbl">Tasa de Engagement</div>
            </div>
          </div>

          <div class="case-transformation">
            <div class="tf-before">
              <span class="tf-title">Antes:</span> 4,200 seguidores estancados, cero captación digital.
            </div>
            <div class="tf-after">
              <span class="tf-title">Después (Casanostra):</span> Estrategia de Vídeo Viral, embudo VSL y agendamiento directo a WhatsApp.
            </div>
          </div>
        </div>

        <!-- Case 2 Content -->
        <div class="case-content" id="case2">
          <div class="case-niche">Finanzas & Consultoría High-Ticket</div>
          <h3>Sofía Valenzuela - Consultora Patrimonial</h3>
          <p class="case-quote">"Casanostra no solo me ayudó a crecer en seguidores reales, sino que construyó un embudo que agenda 40 llamadas calificadas al mes sin yo mover un dedo."</p>

          <div class="case-metrics">
            <div class="metric-card">
              <div class="metric-val text-gradient-gold">+98K</div>
              <div class="metric-lbl">Comunidad Filtrada</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-cyan">$310,000 USD</div>
              <div class="metric-lbl">Contratos High-Ticket</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-purple">4.2x</div>
              <div class="metric-lbl">Retorno sobre Anuncios</div>
            </div>
          </div>

          <div class="case-transformation">
            <div class="tf-before">
              <span class="tf-title">Antes:</span> Dependiente de recomendaciones verbales y redes inactivas.
            </div>
            <div class="tf-after">
              <span class="tf-title">Después (Casanostra):</span> Posicionamiento de líder de opinión, anuncios de atracción y embudo automatizado.
            </div>
          </div>
        </div>

        <!-- Case 3 Content -->
        <div class="case-content" id="case3">
          <div class="case-niche">Tech & Startup Founder</div>
          <h3>Carlos Mendoza - CEO & Investor</h3>
          <p class="case-quote">"Mi marca personal se convirtió en el canal #1 de atracción de capital de riesgo para mi empresa. El retorno de inversión es incalculable."</p>

          <div class="case-metrics">
            <div class="metric-card">
              <div class="metric-val text-gradient-gold">+180K</div>
              <div class="metric-lbl">LinkedIn & X Reach</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-cyan">$1.4M USD</div>
              <div class="metric-lbl">Ronda de Inversión Atraída</div>
            </div>
            <div class="metric-card">
              <div class="metric-val text-gradient-purple">35M+</div>
              <div class="metric-lbl">Impresiones Anuales</div>
            </div>
          </div>

          <div class="case-transformation">
            <div class="tf-before">
              <span class="tf-title">Antes:</span> Sin presencia mediática ni posicionamiento en el ecosistema emprendedor.
            </div>
            <div class="tf-after">
              <span class="tf-title">Después (Casanostra):</span> Columnas digitales, podcasting de autoridad y growth B2B.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .case-studies-wrapper {
    padding: 40px;
    border-radius: 28px;
    background: rgba(18, 22, 34, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 40px;
    align-items: center;
  }

  .case-visual {
    position: relative;
  }

  .case-image-container {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
  }

  .case-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .case-overlay-badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 14px;
    font-size: 0.9rem;
    color: #ffffff;
    background: rgba(7, 9, 14, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse-glow 2s infinite;
  }

  .case-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 24px;
    overflow-x: auto;
    padding-bottom: 6px;
  }

  .case-tab {
    padding: 10px 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .case-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .case-tab.active {
    background: rgba(0, 242, 254, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
  }

  .case-content {
    display: none;
  }

  .case-content.active {
    display: block;
    animation: fadeIn 0.4s ease forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .case-niche {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: 8px;
  }

  .case-content h3 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 14px;
  }

  .case-quote {
    font-style: italic;
    color: var(--text-main);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 24px;
    padding-left: 16px;
    border-left: 3px solid var(--accent-cyan);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .metric-card {
    background: rgba(0, 0, 0, 0.35);
    padding: 14px 12px;
    border-radius: 14px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .metric-val {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 900;
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .case-transformation {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 16px;
    border-radius: 14px;
    font-size: 0.88rem;
  }

  .tf-before {
    color: var(--text-muted);
  }

  .tf-after {
    color: #ffffff;
    font-weight: 600;
  }

  .tf-title {
    font-weight: 700;
    color: var(--accent-gold);
  }

  @media (max-width: 992px) {
    .case-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 576px) {
    .case-studies-wrapper {
      padding: 24px 16px;
    }
    .case-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const caseTabs = document.querySelectorAll('.case-tab');
  const caseContents = document.querySelectorAll('.case-content');

  caseTabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      caseTabs.forEach(t => t.classList.remove('active'));
      caseContents.forEach(c => c.classList.remove('active'));

      const target = e.currentTarget as HTMLElement;
      const caseId = target.dataset.case;
      
      target.classList.add('active');
      document.getElementById(`case${caseId}`)?.classList.add('active');
    });
  });
</script>
