---
---

<section class="section-container" id="contacto">
  <div class="contact-wrapper glass-panel">
    <div class="contact-grid">
      <!-- Contact Copy -->
      <div class="contact-info">
        <div class="badge badge-gold">Sesión Estratégica 1-a-1</div>
        <h2>¿Listo para <span class="text-gradient-gold">Dominar tu Mercado</span> y Multiplicar tus Ventas?</h2>
        
        <p class="contact-desc">
          Agenda una auditoría estratégica gratuita de 30 minutos con nuestro equipo senior de branding. Analizaremos tu presencia actual y te entregaremos un plan de acción a 90 días sin compromiso.
        </p>

        <div class="contact-perks">
          <div class="perk-item">
            <div class="perk-icon">⚡</div>
            <div>
              <strong>Diagnóstico de Redes Gratis</strong>
              <p>Analizamos tus puntos débiles de engagement y conversión.</p>
            </div>
          </div>

          <div class="perk-item">
            <div class="perk-icon">🎯</div>
            <div>
              <strong>Plan Personalizado de Crecimiento</strong>
              <p>Estrategia exacta para tu nicho de mercado.</p>
            </div>
          </div>

          <div class="perk-item">
            <div class="perk-icon">🔒</div>
            <div>
              <strong>Garantía de Confidencialidad</strong>
              <p>Tratamiento de alta discreción para marcas de alto nivel.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="contact-form-container glass-panel-gold">
        <form class="contact-form" id="casanostraForm">
          <h3 class="form-title">Agendar Auditoría Gratis</h3>
          <p class="form-sub">Completa los datos para coordinar tu sesión</p>

          <div class="form-group">
            <label for="fullName">Nombre y Apellido *</label>
            <input type="text" id="fullName" required placeholder="Ej: Carlos Mendoza" class="form-input" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email">Email Profesional *</label>
              <input type="email" id="email" required placeholder="carlos@empresa.com" class="form-input" />
            </div>
            <div class="form-group">
              <label for="phone">WhatsApp / Teléfono *</label>
              <input type="tel" id="phone" required placeholder="+34 600 000 000" class="form-input" />
            </div>
          </div>

          <div class="form-group">
            <label for="brandHandle">Link o usuario de Red Social principal</label>
            <input type="text" id="brandHandle" placeholder="@tumarcapersonal / linkedin.com/in/tuperfil" class="form-input" />
          </div>

          <div class="form-group">
            <label for="goalSelect">¿Cuál es tu objetivo principal actualmente?</label>
            <select id="goalSelect" class="form-select">
              <option value="growth">Ganar Seguidores Reales & Calificados</option>
              <option value="sales">Multiplicar Ventas & Leads High-Ticket</option>
              <option value="brand360">Evolución de Marca Personal 360°</option>
              <option value="video">Fábrica de Contenido Video Viral</option>
            </select>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; margin-top: 12px;" id="submitBtn">
            <span>Agendar Mi Sesión Estratégica</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </button>
        </form>

        <!-- Success Message Overlay -->
        <div class="form-success" id="formSuccess" style="display: none;">
          <div class="success-icon">✓</div>
          <h3>¡Solicitud Recibida!</h3>
          <p>Un consultor senior de <strong>Casanostra Marketing Agency</strong> se comunicará contigo vía WhatsApp en menos de 2 horas hábiles.</p>
          <button class="btn-secondary" id="resetFormBtn" style="margin-top: 20px;">Enviar otra consulta</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-wrapper {
    padding: 60px 48px;
    border-radius: 32px;
    background: rgba(14, 18, 28, 0.85);
    border: 1px solid rgba(226, 184, 89, 0.25);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .contact-info h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 900;
    margin-top: 16px;
    margin-bottom: 18px;
  }

  .contact-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 36px;
  }

  .contact-perks {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .perk-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .perk-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgba(226, 184, 89, 0.15);
    border: 1px solid rgba(226, 184, 89, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .perk-item strong {
    font-size: 1rem;
    color: #ffffff;
    display: block;
    margin-bottom: 2px;
  }

  .perk-item p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  /* Form Styling */
  .contact-form-container {
    padding: 36px 30px;
    border-radius: 24px;
    position: relative;
  }

  .form-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 4px;
    color: #ffffff;
  }

  .form-sub {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #e5e7eb;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-input:focus, .form-select:focus {
    border-color: var(--accent-gold);
    box-shadow: 0 0 10px rgba(226, 184, 89, 0.2);
  }

  .form-select option {
    background: #0B0E14;
    color: #ffffff;
  }

  .form-success {
    text-align: center;
    padding: 40px 20px;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.2);
    border: 2px solid #10B981;
    color: #10B981;
    font-size: 1.8rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
  }

  @media (max-width: 992px) {
    .contact-wrapper {
      padding: 32px 20px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('casanostraForm') as HTMLFormElement;
  const formSuccess = document.getElementById('formSuccess');
  const resetBtn = document.getElementById('resetFormBtn');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.style.display = 'none';
    if (formSuccess) formSuccess.style.display = 'block';
  });

  resetBtn?.addEventListener('click', () => {
    form.reset();
    if (formSuccess) formSuccess.style.display = 'none';
    form.style.display = 'flex';
  });
</script>
