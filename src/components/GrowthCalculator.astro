---
---

<section class="section-container" id="calculadora">
  <div class="section-header">
    <div class="badge badge-gold">Calculadora de Crecimiento & ROI</div>
    <h2>Simula el Impacto Real de <span class="text-gradient-gold">Casanostra</span> en tu Marca</h2>
    <p>Ajusta los parámetros para obtener una estimación basada en datos reales de nuestros clientes activos.</p>
  </div>

  <div class="calculator-wrapper glass-panel">
    <div class="calculator-grid">
      <!-- Input Controls -->
      <div class="calc-inputs">
        <div class="input-group">
          <label class="input-label">1. Selecciona tu Industria o Perfil</label>
          <div class="industry-selector" id="industrySelector">
            <button class="ind-btn active" data-industry="empresa" data-mult="1.2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              CEO / Fundador
            </button>
            <button class="ind-btn" data-industry="coach" data-mult="1.5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"></path><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
              Consultor / Coach
            </button>
            <button class="ind-btn" data-industry="creador" data-mult="2.2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
              Creador de Contenido
            </button>
            <button class="ind-btn" data-industry="b2b" data-mult="1.0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
              Agencia / B2B
            </button>
          </div>
        </div>

        <div class="input-group">
          <div class="slider-header">
            <label class="input-label">2. Presupuesto Mensual de Marketing</label>
            <span class="slider-val" id="budgetDisplay">$2,500 USD</span>
          </div>
          <input 
            type="range" 
            id="budgetSlider" 
            min="1000" 
            max="10000" 
            step="500" 
            value="2500"
            class="custom-range"
          />
          <div class="range-marks">
            <span>$1k</span>
            <span>$3k</span>
            <span>$5k</span>
            <span>$10k+</span>
          </div>
        </div>

        <div class="input-group">
          <div class="slider-header">
            <label class="input-label">3. Ticket Promedio de tu Producto / Servicio</label>
            <span class="slider-val" id="ticketDisplay">$1,200 USD</span>
          </div>
          <input 
            type="range" 
            id="ticketSlider" 
            min="200" 
            max="5000" 
            step="100" 
            value="1200"
            class="custom-range"
          />
          <div class="range-marks">
            <span>$200</span>
            <span>$1,500</span>
            <span>$3,000</span>
            <span>$5,000</span>
          </div>
        </div>
      </div>

      <!-- Results Display Panel -->
      <div class="calc-results glass-panel-gold">
        <div class="results-badge">Proyección a 90 Días</div>
        
        <div class="result-main">
          <div class="result-number text-gradient-gold" id="followersResult">+32,500</div>
          <div class="result-title">Seguidores Reales Estimados</div>
          <p class="result-desc">Audiencia filtrada e interesada genuinamente en tu contenido y servicios.</p>
        </div>

        <div class="results-grid">
          <div class="result-mini-box">
            <div class="mini-val text-gradient-cyan" id="reachResult">850K</div>
            <div class="mini-lbl">Alcance Mensual</div>
          </div>
          <div class="result-mini-box">
            <div class="mini-val text-gradient-purple" id="clientsResult">18 - 26</div>
            <div class="mini-lbl">Nuevos Clientes</div>
          </div>
        </div>

        <div class="roi-summary">
          <div class="roi-row">
            <span>Facturación Adicional Est.</span>
            <strong id="revenueResult" class="text-gradient-gold">$26,400 USD</strong>
          </div>
          <div class="roi-row">
            <span>Retorno de Inversión Est.</span>
            <strong id="roiResult" style="color: #10B981;">+252% ROI</strong>
          </div>
        </div>

        <a href="#contacto" class="btn-primary" style="width: 100%; margin-top: 24px;">
          Reclamar Este Plan de Crecimiento
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .calculator-wrapper {
    padding: 40px;
    background: rgba(18, 22, 34, 0.8);
    border: 1px solid rgba(226, 184, 89, 0.25);
    border-radius: 28px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }

  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .input-label {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .industry-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .ind-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ind-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .ind-btn.active {
    background: rgba(226, 184, 89, 0.15);
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    box-shadow: 0 0 15px rgba(226, 184, 89, 0.2);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-val {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--accent-gold);
  }

  .custom-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
    cursor: pointer;
  }

  .custom-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-gold);
    box-shadow: 0 0 12px var(--accent-gold);
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .custom-range::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .range-marks {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  /* Results Panel */
  .calc-results {
    padding: 36px 30px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .results-badge {
    display: inline-block;
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(226, 184, 89, 0.2);
    border: 1px solid rgba(226, 184, 89, 0.4);
    color: var(--accent-gold);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }

  .result-number {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 6px;
  }

  .result-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .result-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }

  .result-mini-box {
    background: rgba(0, 0, 0, 0.35);
    padding: 14px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mini-val {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .mini-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .roi-summary {
    background: rgba(0, 0, 0, 0.4);
    padding: 16px 20px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid rgba(226, 184, 89, 0.2);
  }

  .roi-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .roi-row strong {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
  }

  @media (max-width: 992px) {
    .calculator-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 576px) {
    .calculator-wrapper {
      padding: 24px 18px;
    }
    .industry-selector {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  let activeMult = 1.2;

  const budgetSlider = document.getElementById('budgetSlider') as HTMLInputElement;
  const ticketSlider = document.getElementById('ticketSlider') as HTMLInputElement;

  const budgetDisplay = document.getElementById('budgetDisplay');
  const ticketDisplay = document.getElementById('ticketDisplay');

  const followersResult = document.getElementById('followersResult');
  const reachResult = document.getElementById('reachResult');
  const clientsResult = document.getElementById('clientsResult');
  const revenueResult = document.getElementById('revenueResult');
  const roiResult = document.getElementById('roiResult');

  function updateCalc() {
    if (!budgetSlider || !ticketSlider) return;

    const budget = parseInt(budgetSlider.value);
    const ticket = parseInt(ticketSlider.value);

    if (budgetDisplay) budgetDisplay.textContent = `$${budget.toLocaleString()} USD`;
    if (ticketDisplay) ticketDisplay.textContent = `$${ticket.toLocaleString()} USD`;

    // Calculations based on budget and active multiplier
    const followers = Math.round((budget * 13) * activeMult);
    const reach = Math.round((followers * 26) / 1000);
    const clientsMin = Math.max(3, Math.round((budget * 0.008) * activeMult));
    const clientsMax = Math.round(clientsMin * 1.5);
    const estRevenue = Math.round(clientsMin * ticket * 1.8);
    const roi = Math.round(((estRevenue - budget * 3) / (budget * 3)) * 100);

    if (followersResult) followersResult.textContent = `+${followers.toLocaleString()}`;
    if (reachResult) reachResult.textContent = `${reach}K`;
    if (clientsResult) clientsResult.textContent = `${clientsMin} - ${clientsMax}`;
    if (revenueResult) revenueResult.textContent = `$${estRevenue.toLocaleString()} USD`;
    if (roiResult) roiResult.textContent = `+${Math.max(120, roi)}% ROI`;
  }

  // Event Listeners
  document.querySelectorAll('.ind-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.ind-btn').forEach(b => b.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');
      activeMult = parseFloat(target.dataset.mult || '1.2');
      updateCalc();
    });
  });

  budgetSlider?.addEventListener('input', updateCalc);
  ticketSlider?.addEventListener('input', updateCalc);

  // Initial calculation run
  updateCalc();
</script>
