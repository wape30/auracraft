---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard Principal | Casanostra Marketing Agency">
  <div class="dashboard-page">
    <!-- Top Header -->
    <header class="dash-header glass-panel">
      <div class="dash-header-container">
        <div class="dash-brand">
          <a href="/" class="brand-logo-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#E2B859" stroke-width="2"/>
              <path d="M2 17L12 22L22 17" stroke="#E2B859" stroke-width="2"/>
              <path d="M2 12L12 17L22 12" stroke="#00F2FE" stroke-width="2"/>
            </svg>
          </a>
          <div>
            <div class="dash-title">CASANOSTRA DASHBOARD</div>
            <div class="dash-sub" id="dashSubText">Plataforma de Seguimiento & Crecimiento</div>
          </div>
        </div>

        <div class="dash-user-panel">
          <!-- Unified Navigation & User Options Collapse Trigger -->
          <button class="nav-collapse-trigger" id="navCollapseTrigger" aria-label="Abrir Menú de Opciones">
            <div class="avatar-circle-sm" id="headerAvatarCircle">
              <img id="headerAvatarImg" src="" alt="Avatar" style="display:none;" />
              <span id="headerAvatarInitials">U</span>
            </div>

            <div class="trigger-user-info hide-mobile">
              <div class="trigger-user-name" id="userNameText">Usuario</div>
              <div class="trigger-role-badge" id="roleText">Cargando...</div>
            </div>

            <svg class="chevron-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </button>

          <!-- Collapsible Options & Navigation Dropdown Menu -->
          <div class="nav-collapse-menu glass-panel" id="navCollapseMenu">
            <div class="menu-user-header">
              <div class="menu-avatar-circle" id="menuAvatarCircle">
                <img id="menuAvatarImg" src="" alt="Avatar" style="display:none;" />
                <span id="menuAvatarInitials">U</span>
              </div>
              <div class="menu-user-details">
                <div class="menu-user-name" id="dropdownUserName">Usuario</div>
                <div class="menu-user-email" id="userEmailText">email@ejemplo.com</div>
                <div class="menu-user-badge">
                  <span id="dropdownRoleText">Cargando...</span>
                </div>
              </div>
            </div>

            <div class="menu-divider"></div>

            <div class="menu-nav-links">
              <button class="menu-item-btn" id="menuBtnProfile">
                <span class="menu-icon">👤</span>
                <div class="menu-item-text">
                  <span class="title">Mi Perfil</span>
                  <span class="sub">Configura tu foto, bio, país y redes</span>
                </div>
              </button>

              <button class="menu-item-btn" id="menuBtnRequests">
                <span class="menu-icon">📋</span>
                <div class="menu-item-text">
                  <span class="title">Solicitudes / Requests</span>
                  <span class="sub">Ver y gestionar trabajos</span>
                </div>
              </button>

              <button class="menu-item-btn" id="menuBtnGoals">
                <span class="menu-icon">🎯</span>
                <div class="menu-item-text">
                  <span class="title">Metas de Crecimiento</span>
                  <span class="sub">Objetivos de marca y métricas</span>
                </div>
              </button>

              <a href="/opciones" class="menu-item-btn">
                <span class="menu-icon">⚙️</span>
                <div class="menu-item-text">
                  <span class="title">Opciones y Tema</span>
                  <span class="sub">Cambiar paleta entre Modo Claro y Oscuro</span>
                </div>
              </a>

              <a href="/busqueda" class="menu-item-btn">
                <span class="menu-icon">🔍</span>
                <div class="menu-item-text">
                  <span class="title">Directorio Búsqueda</span>
                  <span class="sub">Explorar perfiles de usuarios y workers</span>
                </div>
              </a>

              <a href="/" class="menu-item-btn">
                <span class="menu-icon">🌐</span>
                <div class="menu-item-text">
                  <span class="title">Ir al Sitio Web</span>
                  <span class="sub">Página principal de Casanostra</span>
                </div>
              </a>
            </div>

            <div class="menu-divider"></div>

            <div class="menu-footer">
              <button class="menu-logout-btn" id="logoutBtn" title="Cerrar Sesión">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                <span>Cerrar Sesión</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="dash-main-container">
      <!-- WORKER VIEW CONTAINER -->
      <div id="workerDashboard" class="role-dashboard-view" style="display: none;">
        <!-- Worker Stats Summary -->
        <div class="dash-stats-grid">
          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Clientes Asignados</span>
              <span class="stat-icon gold">👥</span>
            </div>
            <div class="stat-val text-gradient-gold" id="wStatClients">3 Clientes</div>
            <div class="stat-desc">Marcas personales en seguimiento</div>
          </div>

          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Solicitudes Pendientes</span>
              <span class="stat-icon cyan">📋</span>
            </div>
            <div class="stat-val text-gradient-cyan" id="wStatPendingReqs">2 Solicitudes</div>
            <div class="stat-desc">Requieren atención o revisión</div>
          </div>

          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Metas en Progreso</span>
              <span class="stat-icon purple">🎯</span>
            </div>
            <div class="stat-val text-gradient-purple" id="wStatActiveGoals">3 Metas</div>
            <div class="stat-desc">Objetivos de crecimiento activos</div>
          </div>
        </div>

        <!-- Worker Section Header & Tabs -->
        <div class="dash-content-panel glass-panel">
          <div class="panel-header">
            <div class="panel-tabs">
              <button class="panel-tab active" id="wTabReqs">
                <span>Gestión de Requests de Clientes</span>
                <span class="tab-count" id="wReqCount">0</span>
              </button>
              <button class="panel-tab" id="wTabGoals">
                <span>Seguimiento de Metas</span>
                <span class="tab-count" id="wGoalCount">0</span>
              </button>
              <button class="panel-tab" id="wTabProfile">
                <span>👤 Mi Perfil</span>
              </button>
            </div>

            <button class="btn-primary btn-sm" id="wOpenGoalModalBtn">
              + Asignar Nueva Meta a Cliente
            </button>
          </div>

          <!-- Worker Tab 1: Requests Management -->
          <div class="tab-content active" id="wReqsTabContent">
            <div class="table-responsive">
              <table class="dash-table">
                <thead>
                  <tr>
                    <th>Cliente</th>
                    <th>Solicitud</th>
                    <th>Tipo</th>
                    <th>Prioridad</th>
                    <th>Fecha</th>
                    <th>Estado de Seguimiento (Worker)</th>
                  </tr>
                </thead>
                <tbody id="workerReqsTableBody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Worker Tab 2: Goals Tracking -->
          <div class="tab-content" id="wGoalsTabContent">
            <div class="goals-grid" id="workerGoalsGrid">
              <!-- Rendered dynamically -->
            </div>
          </div>

          <!-- Worker Tab 3: Profile Page -->
          <div class="tab-content" id="wProfileTabContent">
            <div class="profile-layout-grid">
              <!-- Left Column: Profile Card Preview -->
              <div class="profile-preview-card glass-panel-gold">
                <div class="profile-avatar-wrapper">
                  <div class="profile-avatar-large cardAvatarCircle">
                    <img class="cardAvatarImg" src="" alt="Foto de Perfil" style="display:none;" />
                    <span class="cardAvatarInitials">W</span>
                  </div>
                  <div class="online-indicator" title="En línea"></div>
                </div>

                <h3 class="profile-card-name cardDisplayName">Worker Name</h3>
                <div class="profile-card-role cardRoleText">⚡ WORKER / GROWTH MANAGER</div>
                <div class="profile-card-company cardCompanyText">Casanostra Staff</div>

                <div class="profile-card-divider"></div>

                <p class="profile-card-bio cardBioText">
                  Sin descripción agregada aún. Edita tu perfil para añadir tu resumen profesional o especialidad.
                </p>

                <div class="profile-card-details">
                  <div class="profile-detail-item">
                    <span class="detail-icon">📍</span>
                    <span class="cardLocationText">Ubicación no especificada</span>
                  </div>
                  <div class="profile-detail-item">
                    <span class="detail-icon">📞</span>
                    <span class="cardPhoneText">Teléfono no especificado</span>
                  </div>
                  <div class="profile-detail-item">
                    <span class="detail-icon">✉️</span>
                    <span class="cardEmailText">email@ejemplo.com</span>
                  </div>
                </div>

                <div class="profile-social-section">
                  <div class="social-section-title">Redes Sociales & Contacto</div>
                  <div class="social-links-grid cardSocialsGrid">
                    <!-- Rendered dynamically -->
                  </div>
                </div>
              </div>

              <!-- Right Column: Profile Edit Form -->
              <div class="profile-edit-card glass-panel">
                <div class="edit-card-header">
                  <h3>✏️ Configuración de Perfil (Worker)</h3>
                  <p>Mantén tu información actualizada para tus clientes y el equipo de la agencia.</p>
                </div>

                <form class="profileEditForm profile-form">
                  <div class="form-section-title">📷 Foto de Perfil</div>
                  <div class="form-row align-center">
                    <div class="form-group" style="flex: 2;">
                      <label>URL de Foto de Perfil</label>
                      <input type="url" class="inputPhotoUrl form-input" placeholder="https://ejemplo.com/foto.jpg" />
                    </div>
                    <div class="form-group" style="flex: 1;">
                      <label>Subir Imagen</label>
                      <label class="btn-file-upload">
                        <span>📁 Elegir</span>
                        <input type="file" class="inputPhotoFile" accept="image/*" style="display:none;" />
                      </label>
                    </div>
                  </div>

                  <div class="avatar-presets-picker">
                    <span class="preset-label">Avatares sugeridos:</span>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=250&q=80">Avatar 1</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=250&q=80">Avatar 2</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=250&q=80">Avatar 3</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=250&q=80">Avatar 4</button>
                  </div>

                  <div class="form-section-title" style="margin-top: 20px;">👤 Datos Principales</div>
                  <div class="form-row">
                    <div class="form-group">
                      <label>Nombre Completo / Marca *</label>
                      <input type="text" class="inputDisplayName form-input" required placeholder="Tu nombre público" />
                    </div>
                    <div class="form-group">
                      <label>Teléfono de Contacto</label>
                      <input type="tel" class="inputPhone form-input" placeholder="+34 600 000 000" />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>País</label>
                      <input type="text" class="inputCountry form-input" placeholder="Ej: España, México, Colombia" />
                    </div>
                    <div class="form-group">
                      <label>Ciudad</label>
                      <input type="text" class="inputCity form-input" placeholder="Ej: Madrid, CDMX, Medellín" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Descripción General / Especialidad</label>
                    <textarea class="inputDescription form-textarea" rows="3" placeholder="Resumen de tu rol, especialización en Paid Ads, Vídeo Viral, Embudos de Venta o Creatividad..."></textarea>
                  </div>

                  <div class="form-section-title" style="margin-top: 20px;">🌐 Redes Sociales</div>
                  <div class="form-row">
                    <div class="form-group">
                      <label>Instagram</label>
                      <input type="text" class="inputInstagram form-input" placeholder="@usuario o https://instagram.com/..." />
                    </div>
                    <div class="form-group">
                      <label>LinkedIn</label>
                      <input type="text" class="inputLinkedin form-input" placeholder="https://linkedin.com/in/usuario" />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Twitter / X</label>
                      <input type="text" class="inputTwitter form-input" placeholder="@usuario o https://x.com/..." />
                    </div>
                    <div class="form-group">
                      <label>YouTube / TikTok</label>
                      <input type="text" class="inputYoutube form-input" placeholder="https://youtube.com/@canal" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Sitio Web / Portfolio</label>
                    <input type="url" class="inputWebsite form-input" placeholder="https://tuweb.com" />
                  </div>

                  <div class="profile-form-footer">
                    <span class="profileStatusMsg status-toast" style="display:none;"></span>
                    <button type="submit" class="saveProfileBtn btn-primary">
                      💾 Guardar Cambios de Perfil
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- CLIENT VIEW CONTAINER -->
      <div id="clientDashboard" class="role-dashboard-view" style="display: none;">
        <!-- Client Stats Summary -->
        <div class="dash-stats-grid">
          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Mis Solicitudes Activas</span>
              <span class="stat-icon gold">📁</span>
            </div>
            <div class="stat-val text-gradient-gold" id="cStatReqs">0 Solicitudes</div>
            <div class="stat-desc">Vídeos, Ads y Embudos en producción</div>
          </div>

          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Metas de Crecimiento</span>
              <span class="stat-icon cyan">🚀</span>
            </div>
            <div class="stat-val text-gradient-cyan" id="cStatGoals">0 Metas</div>
            <div class="stat-desc">Objetivos de audiencia y ventas</div>
          </div>

          <div class="dash-stat-card glass-panel">
            <div class="stat-top">
              <span class="stat-lbl">Equipo Asignado</span>
              <span class="stat-icon purple">⭐</span>
            </div>
            <div class="stat-val text-gradient-purple">Casanostra Core</div>
            <div class="stat-desc">Growth Manager dedicado</div>
          </div>
        </div>

        <!-- Client Section Header & Tabs -->
        <div class="dash-content-panel glass-panel">
          <div class="panel-header">
            <div class="panel-tabs">
              <button class="panel-tab active" id="cTabReqs">
                <span>Mis Requests (Solicitudes)</span>
              </button>
              <button class="panel-tab" id="cTabGoals">
                <span>Mis Metas Propuestas</span>
              </button>
              <button class="panel-tab" id="cTabProfile">
                <span>👤 Mi Perfil</span>
              </button>
            </div>

            <button class="btn-primary btn-sm" id="cOpenReqModalBtn">
              + Nueva Solicitud de Trabajo
            </button>
          </div>

          <!-- Client Tab 1: My Requests -->
          <div class="tab-content active" id="cReqsTabContent">
            <div class="requests-grid" id="clientReqsGrid">
              <!-- Rendered dynamically -->
            </div>
          </div>

          <!-- Client Tab 2: My Goals -->
          <div class="tab-content" id="cGoalsTabContent">
            <div class="goals-grid" id="clientGoalsGrid">
              <!-- Rendered dynamically -->
            </div>
          </div>

          <!-- Client Tab 3: Profile Page -->
          <div class="tab-content" id="cProfileTabContent">
            <div class="profile-layout-grid">
              <!-- Left Column: Profile Card Preview -->
              <div class="profile-preview-card glass-panel-gold">
                <div class="profile-avatar-wrapper">
                  <div class="profile-avatar-large cardAvatarCircle">
                    <img class="cardAvatarImg" src="" alt="Foto de Perfil" style="display:none;" />
                    <span class="cardAvatarInitials">C</span>
                  </div>
                  <div class="online-indicator" title="En línea"></div>
                </div>

                <h3 class="profile-card-name cardDisplayName">Client Name</h3>
                <div class="profile-card-role cardRoleText">💼 CLIENTE / MARCA PERSONAL</div>
                <div class="profile-card-company cardCompanyText">Marca Personal</div>

                <div class="profile-card-divider"></div>

                <p class="profile-card-bio cardBioText">
                  Sin descripción agregada aún. Edita tu perfil para añadir la descripción de tu marca o empresa.
                </p>

                <div class="profile-card-details">
                  <div class="profile-detail-item">
                    <span class="detail-icon">📍</span>
                    <span class="cardLocationText">Ubicación no especificada</span>
                  </div>
                  <div class="profile-detail-item">
                    <span class="detail-icon">📞</span>
                    <span class="cardPhoneText">Teléfono no especificado</span>
                  </div>
                  <div class="profile-detail-item">
                    <span class="detail-icon">✉️</span>
                    <span class="cardEmailText">email@ejemplo.com</span>
                  </div>
                </div>

                <div class="profile-social-section">
                  <div class="social-section-title">Redes Sociales & Canales</div>
                  <div class="social-links-grid cardSocialsGrid">
                    <!-- Rendered dynamically -->
                  </div>
                </div>
              </div>

              <!-- Right Column: Profile Edit Form -->
              <div class="profile-edit-card glass-panel">
                <div class="edit-card-header">
                  <h3>✏️ Configuración de Perfil (Cliente)</h3>
                  <p>Configura tu foto de perfil, descripción de marca, ciudad, país y redes sociales.</p>
                </div>

                <form class="profileEditForm profile-form">
                  <div class="form-section-title">📷 Foto de Perfil</div>
                  <div class="form-row align-center">
                    <div class="form-group" style="flex: 2;">
                      <label>URL de Foto de Perfil</label>
                      <input type="url" class="inputPhotoUrl form-input" placeholder="https://ejemplo.com/foto.jpg" />
                    </div>
                    <div class="form-group" style="flex: 1;">
                      <label>Subir Imagen</label>
                      <label class="btn-file-upload">
                        <span>📁 Elegir</span>
                        <input type="file" class="inputPhotoFile" accept="image/*" style="display:none;" />
                      </label>
                    </div>
                  </div>

                  <div class="avatar-presets-picker">
                    <span class="preset-label">Avatares sugeridos:</span>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=250&q=80">Avatar 1</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=250&q=80">Avatar 2</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=250&q=80">Avatar 3</button>
                    <button type="button" class="preset-avatar-btn" data-url="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=250&q=80">Avatar 4</button>
                  </div>

                  <div class="form-section-title" style="margin-top: 20px;">👤 Datos Principales</div>
                  <div class="form-row">
                    <div class="form-group">
                      <label>Nombre Completo / Marca *</label>
                      <input type="text" class="inputDisplayName form-input" required placeholder="Tu nombre o marca" />
                    </div>
                    <div class="form-group">
                      <label>Teléfono de Contacto</label>
                      <input type="tel" class="inputPhone form-input" placeholder="+34 600 000 000" />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>País</label>
                      <input type="text" class="inputCountry form-input" placeholder="Ej: España, México, Colombia" />
                    </div>
                    <div class="form-group">
                      <label>Ciudad</label>
                      <input type="text" class="inputCity form-input" placeholder="Ej: Madrid, CDMX, Medellín" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Descripción General de tu Marca / Proyecto</label>
                    <textarea class="inputDescription form-textarea" rows="3" placeholder="Describe tu marca personal, empresa, propuesta de valor u objetivos de contenido..."></textarea>
                  </div>

                  <div class="form-section-title" style="margin-top: 20px;">🌐 Redes Sociales</div>
                  <div class="form-row">
                    <div class="form-group">
                      <label>Instagram</label>
                      <input type="text" class="inputInstagram form-input" placeholder="@usuario o https://instagram.com/..." />
                    </div>
                    <div class="form-group">
                      <label>LinkedIn</label>
                      <input type="text" class="inputLinkedin form-input" placeholder="https://linkedin.com/in/usuario" />
                    </div>
                  </div>

                  <div class="form-row">
                    <div class="form-group">
                      <label>Twitter / X</label>
                      <input type="text" class="inputTwitter form-input" placeholder="@usuario o https://x.com/..." />
                    </div>
                    <div class="form-group">
                      <label>YouTube / TikTok</label>
                      <input type="text" class="inputYoutube form-input" placeholder="https://youtube.com/@canal" />
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Sitio Web / Portfolio</label>
                    <input type="url" class="inputWebsite form-input" placeholder="https://tuweb.com" />
                  </div>

                  <div class="profile-form-footer">
                    <span class="profileStatusMsg status-toast" style="display:none;"></span>
                    <button type="submit" class="saveProfileBtn btn-primary">
                      💾 Guardar Cambios de Perfil
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 1: Create New Request (Client) -->
  <div class="modal-backdrop" id="newReqModal">
    <div class="modal-card glass-panel-gold">
      <div class="modal-header">
        <h3>Crear Nueva Solicitud de Trabajo</h3>
        <button class="close-modal" id="closeReqModal">&times;</button>
      </div>
      <form id="newReqForm" class="modal-form">
        <div class="form-group">
          <label>Título de la Solicitud *</label>
          <input type="text" id="reqTitle" required placeholder="Ej: Edición de 4 Reels sobre Estrategia de Ventas" class="form-input" />
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Tipo de Servicio *</label>
            <select id="reqType" class="form-select">
              <option value="video_viral">Vídeo Viral (Reels / Shorts)</option>
              <option value="paid_ads">Campañas Paid Ads</option>
              <option value="funnel_vsl">Funnel High-Ticket VSL</option>
              <option value="branding_design">Diseño & Branding</option>
