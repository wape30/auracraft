    border-radius: 12px;
  }

  .preset-label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .preset-avatar-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preset-avatar-btn:hover {
    background: var(--accent-gold);
    color: #07090e;
  }

  .profile-form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .status-toast {
    font-size: 0.85rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
  }

  .status-toast.success {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  @media (max-width: 992px) {
    .profile-layout-grid {
      grid-template-columns: 1fr;
    }
    .dash-stats-grid {
      grid-template-columns: 1fr;
    }
    .panel-header {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { 
    getActiveSession, 
    logout, 
    fetchRequests, 
    fetchGoals, 
    updateRequestStatus, 
    updateGoalProgress, 
    addRequest, 
    addGoal, 
    fetchRegisteredClients,
    updateUserProfile,
    type UserProfile 
  } from '../lib/firebase';

  let activeUser: UserProfile | null = null;

  document.addEventListener('DOMContentLoaded', async () => {
    activeUser = getActiveSession();

    if (!activeUser) {
      window.location.href = '/login';
      return;
    }

    // Render User Header Details
    const roleBadge = document.getElementById('userRoleBadge');
    const roleText = document.getElementById('roleText');
    const userNameText = document.getElementById('userNameText');
    const userEmailText = document.getElementById('userEmailText');

    if (userNameText) userNameText.textContent = activeUser.displayName;
    if (userEmailText) userEmailText.textContent = activeUser.email;

    setupProfileData();

    if (activeUser.role === 'worker') {
      roleBadge?.classList.add('worker');
      if (roleText) roleText.textContent = '⚡ WORKER / GROWTH MANAGER';
      document.getElementById('workerDashboard')?.style.setProperty('display', 'block');
      await renderWorkerDashboard();
      await populateClientDropdown();
    } else {
      roleBadge?.classList.add('client');
      if (roleText) roleText.textContent = '💼 CLIENTE / MARCA PERSONAL';
      document.getElementById('clientDashboard')?.style.setProperty('display', 'block');
      await renderClientDashboard();
    }
  });

  // Logout listener
  document.getElementById('logoutBtn')?.addEventListener('click', () => {
    logout();
    window.location.href = '/login';
  });

  // Populate Profile Card and Inputs
  function setupProfileData() {
    if (!activeUser) return;

    // Header Avatar
    const headerAvatarImg = document.getElementById('headerAvatarImg') as HTMLImageElement;
    const headerAvatarInitials = document.getElementById('headerAvatarInitials');
    if (activeUser.photoURL && headerAvatarImg && headerAvatarInitials) {
      headerAvatarImg.src = activeUser.photoURL;
      headerAvatarImg.style.display = 'block';
      headerAvatarInitials.style.display = 'none';
    } else if (headerAvatarInitials) {
      headerAvatarInitials.textContent = (activeUser.displayName || activeUser.email || 'U')[0].toUpperCase();
    }

    // Dropdown Menu Avatar & Info
    const menuAvatarImg = document.getElementById('menuAvatarImg') as HTMLImageElement;
    const menuAvatarInitials = document.getElementById('menuAvatarInitials');
    if (activeUser.photoURL && menuAvatarImg && menuAvatarInitials) {
      menuAvatarImg.src = activeUser.photoURL;
      menuAvatarImg.style.display = 'block';
      menuAvatarInitials.style.display = 'none';
    } else if (menuAvatarInitials) {
      menuAvatarInitials.textContent = (activeUser.displayName || activeUser.email || 'U')[0].toUpperCase();
    }

    const dropdownUserName = document.getElementById('dropdownUserName');
    if (dropdownUserName) dropdownUserName.textContent = activeUser.displayName || 'Usuario';

    const dropdownRoleText = document.getElementById('dropdownRoleText');
    if (dropdownRoleText) {
      dropdownRoleText.textContent = activeUser.role === 'worker' ? '⚡ WORKER / GROWTH MANAGER' : '💼 CLIENTE / MARCA PERSONAL';
    }

    // Populate profile cards elements
    document.querySelectorAll('.cardDisplayName').forEach(el => el.textContent = activeUser?.displayName || 'Usuario');
    document.querySelectorAll('.cardRoleText').forEach(el => {
      el.textContent = activeUser?.role === 'worker' ? '⚡ WORKER / GROWTH MANAGER' : '💼 CLIENTE / MARCA PERSONAL';
    });
    document.querySelectorAll('.cardCompanyText').forEach(el => {
      el.textContent = activeUser?.companyName || (activeUser?.role === 'worker' ? 'Casanostra Staff' : 'Marca Personal');
    });

    document.querySelectorAll('.cardBioText').forEach(el => {
      el.textContent = activeUser?.description || (
        activeUser?.role === 'worker'
          ? 'Sin descripción agregada aún. Edita tu perfil para añadir tu resumen profesional o especialidad.'
          : 'Sin descripción agregada aún. Edita tu perfil para añadir la descripción de tu marca o empresa.'
      );
    });

    document.querySelectorAll('.cardLocationText').forEach(el => {
      const loc = [activeUser?.city, activeUser?.country].filter(Boolean).join(', ');
      el.textContent = loc || 'Ubicación no especificada';
    });

    document.querySelectorAll('.cardPhoneText').forEach(el => {
      el.textContent = activeUser?.phone || 'Teléfono no especificado';
    });

    document.querySelectorAll('.cardEmailText').forEach(el => {
      el.textContent = activeUser?.email || '';
    });

    // Avatars in profile preview cards
    document.querySelectorAll('.cardAvatarCircle').forEach(circle => {
      const img = circle.querySelector('.cardAvatarImg') as HTMLImageElement;
      const initials = circle.querySelector('.cardAvatarInitials');
      if (activeUser?.photoURL && img && initials) {
        img.src = activeUser.photoURL;
        img.style.display = 'block';
        initials.style.display = 'none';
      } else if (initials) {
        initials.textContent = (activeUser?.displayName || 'U')[0].toUpperCase();
      }
    });

    // Social Links Badges
    document.querySelectorAll('.cardSocialsGrid').forEach(grid => {
      const socials = activeUser?.socials || {};
      const links = [];
      if (socials.instagram) links.push({ name: 'Instagram', url: formatSocialUrl(socials.instagram, 'instagram.com/'), icon: '📸' });
      if (socials.linkedin) links.push({ name: 'LinkedIn', url: formatSocialUrl(socials.linkedin, 'linkedin.com/in/'), icon: '💼' });
      if (socials.twitter) links.push({ name: 'Twitter/X', url: formatSocialUrl(socials.twitter, 'x.com/'), icon: '🐦' });
      if (socials.youtube) links.push({ name: 'YouTube', url: formatSocialUrl(socials.youtube, 'youtube.com/'), icon: '▶️' });
      if (socials.website) links.push({ name: 'Web', url: formatSocialUrl(socials.website, ''), icon: '🌐' });

      if (links.length === 0) {
        grid.innerHTML = '<span style="font-size:0.8rem; color:var(--text-dim)">No se han añadido redes sociales aún.</span>';
      } else {
        grid.innerHTML = links.map(l => `
          <a href="${l.url}" target="_blank" rel="noopener noreferrer" class="social-badge-link">
            <span>${l.icon}</span>
            <span>${l.name}</span>
          </a>
        `).join('');
      }
    });

    // Fill form inputs
    document.querySelectorAll('.profileEditForm').forEach(form => {
      const f = form as HTMLFormElement;
      const photoInput = f.querySelector('.inputPhotoUrl') as HTMLInputElement;
      const nameInput = f.querySelector('.inputDisplayName') as HTMLInputElement;
      const phoneInput = f.querySelector('.inputPhone') as HTMLInputElement;
      const countryInput = f.querySelector('.inputCountry') as HTMLInputElement;
      const cityInput = f.querySelector('.inputCity') as HTMLInputElement;
      const descInput = f.querySelector('.inputDescription') as HTMLTextAreaElement;

      if (photoInput) photoInput.value = activeUser?.photoURL || '';
      if (nameInput) nameInput.value = activeUser?.displayName || '';
      if (phoneInput) phoneInput.value = activeUser?.phone || '';
      if (countryInput) countryInput.value = activeUser?.country || '';
      if (cityInput) cityInput.value = activeUser?.city || '';
      if (descInput) descInput.value = activeUser?.description || '';

      const s = activeUser?.socials || {};
      const igInput = f.querySelector('.inputInstagram') as HTMLInputElement;
      const liInput = f.querySelector('.inputLinkedin') as HTMLInputElement;
      const twInput = f.querySelector('.inputTwitter') as HTMLInputElement;
      const ytInput = f.querySelector('.inputYoutube') as HTMLInputElement;
      const webInput = f.querySelector('.inputWebsite') as HTMLInputElement;

      if (igInput) igInput.value = s.instagram || '';
      if (liInput) liInput.value = s.linkedin || '';
      if (twInput) twInput.value = s.twitter || '';
      if (ytInput) ytInput.value = s.youtube || '';
      if (webInput) webInput.value = s.website || '';
    });
  }

  function formatSocialUrl(value: string, domainPrefix: string): string {
    if (!value) return '';
    let val = value.trim();
    if (val.startsWith('http://') || val.startsWith('https://')) return val;
    if (val.startsWith('@')) val = val.substring(1);
    if (domainPrefix && !val.includes(domainPrefix)) {
      return `https://${domainPrefix}${val}`;
    }
    return `https://${val}`;
  }

  // Populate dynamic registered clients for Worker goal assignment
  async function populateClientDropdown() {
    const select = document.getElementById('goalClientSelect') as HTMLSelectElement;
    if (!select) return;
    select.innerHTML = '<option value="">Cargando clientes registrados...</option>';
    const clients = await fetchRegisteredClients();
    if (clients.length === 0) {
      select.innerHTML = '<option value="">No hay clientes registrados en el sistema aún</option>';
      return;
    }
    select.innerHTML = '<option value="">-- Selecciona un cliente registrado --</option>' +
      clients.map(c => `<option value="${c.uid}|${c.displayName}">${c.displayName} (${c.companyName || c.email})</option>`).join('');
  }

  // --- WORKER DASHBOARD LOGIC ---
  async function renderWorkerDashboard() {
    if (!activeUser) return;
    const reqs = await fetchRequests(activeUser);
    const goals = await fetchGoals(activeUser);

    const pending = reqs.filter(r => r.status !== 'completado').length;
    const activeGoalsCount = goals.filter(g => g.status === 'en_progreso').length;

    const wStatReqs = document.getElementById('wStatPendingReqs');
    const wStatGoals = document.getElementById('wStatActiveGoals');
    const wReqCount = document.getElementById('wReqCount');
    const wGoalCount = document.getElementById('wGoalCount');

    if (wStatReqs) wStatReqs.textContent = `${pending} Solicitudes`;
    if (wStatGoals) wStatGoals.textContent = `${activeGoalsCount} Metas`;
    if (wReqCount) wReqCount.textContent = `${reqs.length}`;
    if (wGoalCount) wGoalCount.textContent = `${goals.length}`;

    // Render Worker Requests Table
    const tbody = document.getElementById('workerReqsTableBody');
    if (tbody) {
      if (reqs.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--text-dim)">No hay solicitudes registradas en la plataforma.</td></tr>';
      } else {
        tbody.innerHTML = reqs.map(r => `
          <tr>
            <td><strong>${r.clientName}</strong></td>
            <td>${r.title}</td>
            <td><span class="badge badge-gold" style="font-size:0.75rem">${r.type}</span></td>
            <td><span class="item-tag tag-${r.priority}">${r.priority}</span></td>
            <td>${r.createdAt}</td>
            <td>
              <select class="status-select" data-reqid="${r.id}">
                <option value="pendiente" ${r.status === 'pendiente' ? 'selected' : ''}>⏳ Pendiente</option>
                <option value="en_proceso" ${r.status === 'en_proceso' ? 'selected' : ''}>⚙️ En Proceso</option>
                <option value="en_revision" ${r.status === 'en_revision' ? 'selected' : ''}>👁️ En Revisión</option>
                <option value="completado" ${r.status === 'completado' ? 'selected' : ''}>✅ Completado</option>
              </select>
            </td>
          </tr>
        `).join('');

        tbody.querySelectorAll('.status-select').forEach(select => {
          select.addEventListener('change', async (e) => {
            const target = e.target as HTMLSelectElement;
            const reqId = target.dataset.reqid;
            if (reqId) {
              await updateRequestStatus(reqId, target.value as any);
              await renderWorkerDashboard();
            }
          });
        });
      }
    }

    // Render Worker Goals Grid
    const goalsGrid = document.getElementById('workerGoalsGrid');
    if (goalsGrid) {
      if (goals.length === 0) {
        goalsGrid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding:30px; color:var(--text-dim)">No hay metas asignadas en el sistema. Haz clic en "Asignar Nueva Meta a Cliente" para comenzar.</div>';
      } else {
        goalsGrid.innerHTML = goals.map(g => `
          <div class="item-card glass-panel">
            <div class="item-header">
              <span class="badge badge-cyan" style="font-size:0.75rem">${g.clientName}</span>
              <span class="badge badge-gold" style="font-size:0.75rem">${g.status}</span>
            </div>
            <h4>${g.title}</h4>
            <p>Métrica Meta: <strong>${g.targetMetric}</strong></p>
            <div>
              <div style="display:flex; justify-content:space-between; font-size:0.85rem">
                <span>Progreso:</span>
                <strong style="color:var(--accent-gold)">${g.currentProgress}%</strong>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width: ${g.currentProgress}%"></div>
              </div>
            </div>
            <div style="margin-top:16px; display:flex; gap:8px;">
              <input type="range" min="0" max="100" value="${g.currentProgress}" class="worker-goal-slider" data-goalid="${g.id}" style="width:100%" />
              <button class="btn-primary btn-sm save-goal-btn" data-goalid="${g.id}">Guardar</button>
            </div>
          </div>
        `).join('');

        goalsGrid.querySelectorAll('.save-goal-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const goalId = (e.currentTarget as HTMLElement).dataset.goalid;
            const slider = goalsGrid.querySelector(`.worker-goal-slider[data-goalid="${goalId}"]`) as HTMLInputElement;
            if (goalId && slider) {
              const val = parseInt(slider.value);
              const status = val >= 100 ? 'alcanzada' : 'en_progreso';
              await updateGoalProgress(goalId, val, status);
              await renderWorkerDashboard();
            }
          });
        });
      }
    }
  }

  // --- CLIENT DASHBOARD LOGIC ---
  async function renderClientDashboard() {
    if (!activeUser) return;
    const reqs = await fetchRequests(activeUser);
    const goals = await fetchGoals(activeUser);

    const cStatReqs = document.getElementById('cStatReqs');
    const cStatGoals = document.getElementById('cStatGoals');

    if (cStatReqs) cStatReqs.textContent = `${reqs.length} Solicitudes`;
    if (cStatGoals) cStatGoals.textContent = `${goals.length} Metas`;

    // Render Client Requests Grid
    const reqsGrid = document.getElementById('clientReqsGrid');
    if (reqsGrid) {
      if (reqs.length === 0) {
        reqsGrid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding:30px; color:var(--text-dim)">Aún no has creado ninguna solicitud. Haz clic en "Nueva Solicitud de Servicio" para realizar un pedido a tu equipo.</div>';
      } else {
        reqsGrid.innerHTML = reqs.map(r => `
          <div class="item-card glass-panel">
            <div class="item-header">
              <span class="item-tag tag-${r.priority}">Prioridad ${r.priority}</span>
              <span class="badge badge-gold" style="font-size:0.75rem">${r.status.toUpperCase()}</span>
            </div>
            <h4>${r.title}</h4>
            <p>${r.description}</p>
            <div style="font-size:0.8rem; color:var(--text-dim); border-top:1px solid rgba(255,255,255,0.06); padding-top:12px;">
              Atendido por: <strong>${r.assignedWorker}</strong>
            </div>
          </div>
        `).join('');
      }
    }

    // Render Client Goals Grid
    const goalsGrid = document.getElementById('clientGoalsGrid');
    if (goalsGrid) {
      if (goals.length === 0) {
        goalsGrid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding:30px; color:var(--text-dim)">Tu equipo aún no ha establecido metas específicas para tu marca personal.</div>';
      } else {
        goalsGrid.innerHTML = goals.map(g => `
          <div class="item-card glass-panel">
            <div class="item-header">
              <span class="badge badge-cyan" style="font-size:0.75rem">Meta de Crecimiento</span>
              <span class="badge badge-gold" style="font-size:0.75rem">${g.status}</span>
            </div>
            <h4>${g.title}</h4>
            <p>Métrica Meta: <strong style="color:#ffffff">${g.targetMetric}</strong></p>
            <div>
              <div style="display:flex; justify-content:space-between; font-size:0.85rem">
                <span>Avance Estimado:</span>
                <strong style="color:var(--accent-gold)">${g.currentProgress}%</strong>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width: ${g.currentProgress}%"></div>
              </div>
            </div>
          </div>
        `).join('');
      }
    }
  }

  // Navbar Profile Activation Helper
  function activateProfileTab() {
    if (!activeUser) return;
    if (activeUser.role === 'worker') {
      document.getElementById('wTabProfile')?.click();
    } else {
      document.getElementById('cTabProfile')?.click();
    }
  }

  // Collapse Dropdown Toggle Listener
  const navCollapseTrigger = document.getElementById('navCollapseTrigger');
  const navCollapseMenu = document.getElementById('navCollapseMenu');

  function closeNavCollapseMenu() {
    navCollapseTrigger?.classList.remove('active');
    navCollapseMenu?.classList.remove('active');
  }

  function toggleNavCollapseMenu() {
    navCollapseTrigger?.classList.toggle('active');
    navCollapseMenu?.classList.toggle('active');
  }

  navCollapseTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleNavCollapseMenu();
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#navCollapseTrigger') && !target.closest('#navCollapseMenu')) {
      closeNavCollapseMenu();
    }
  });

  // Dropdown Menu Links Navigation Handlers
  document.getElementById('menuBtnProfile')?.addEventListener('click', () => {
    activateProfileTab();
    closeNavCollapseMenu();
  });

  document.getElementById('menuBtnRequests')?.addEventListener('click', () => {
    if (activeUser?.role === 'worker') {
      document.getElementById('wTabReqs')?.click();
    } else {
      document.getElementById('cTabReqs')?.click();
    }
    closeNavCollapseMenu();
  });

  document.getElementById('menuBtnGoals')?.addEventListener('click', () => {
    if (activeUser?.role === 'worker') {
      document.getElementById('wTabGoals')?.click();
    } else {
      document.getElementById('cTabGoals')?.click();
    }
    closeNavCollapseMenu();
  });

  // Worker Tabs Toggle
  document.getElementById('wTabReqs')?.addEventListener('click', () => {
    document.getElementById('wTabReqs')?.classList.add('active');
    document.getElementById('wTabGoals')?.classList.remove('active');
    document.getElementById('wTabProfile')?.classList.remove('active');

    document.getElementById('wReqsTabContent')?.classList.add('active');
    document.getElementById('wGoalsTabContent')?.classList.remove('active');
    document.getElementById('wProfileTabContent')?.classList.remove('active');
  });

  document.getElementById('wTabGoals')?.addEventListener('click', () => {
    document.getElementById('wTabGoals')?.classList.add('active');
    document.getElementById('wTabReqs')?.classList.remove('active');
    document.getElementById('wTabProfile')?.classList.remove('active');

    document.getElementById('wGoalsTabContent')?.classList.add('active');
    document.getElementById('wReqsTabContent')?.classList.remove('active');
    document.getElementById('wProfileTabContent')?.classList.remove('active');
  });

  document.getElementById('wTabProfile')?.addEventListener('click', () => {
    document.getElementById('wTabProfile')?.classList.add('active');
    document.getElementById('wTabReqs')?.classList.remove('active');
    document.getElementById('wTabGoals')?.classList.remove('active');

    document.getElementById('wProfileTabContent')?.classList.add('active');
    document.getElementById('wReqsTabContent')?.classList.remove('active');
    document.getElementById('wGoalsTabContent')?.classList.remove('active');
  });

  // Client Tabs Toggle
  document.getElementById('cTabReqs')?.addEventListener('click', () => {
    document.getElementById('cTabReqs')?.classList.add('active');
    document.getElementById('cTabGoals')?.classList.remove('active');
    document.getElementById('cTabProfile')?.classList.remove('active');

    document.getElementById('cReqsTabContent')?.classList.add('active');
    document.getElementById('cGoalsTabContent')?.classList.remove('active');
    document.getElementById('cProfileTabContent')?.classList.remove('active');
  });

  document.getElementById('cTabGoals')?.addEventListener('click', () => {
    document.getElementById('cTabGoals')?.classList.add('active');
    document.getElementById('cTabReqs')?.classList.remove('active');
    document.getElementById('cTabProfile')?.classList.remove('active');

    document.getElementById('cGoalsTabContent')?.classList.add('active');
    document.getElementById('cReqsTabContent')?.classList.remove('active');
    document.getElementById('cProfileTabContent')?.classList.remove('active');
  });

  document.getElementById('cTabProfile')?.addEventListener('click', () => {
    document.getElementById('cTabProfile')?.classList.add('active');
    document.getElementById('cTabReqs')?.classList.remove('active');
    document.getElementById('cTabGoals')?.classList.remove('active');

    document.getElementById('cProfileTabContent')?.classList.add('active');
    document.getElementById('cReqsTabContent')?.classList.remove('active');
    document.getElementById('cGoalsTabContent')?.classList.remove('active');
  });

  // Profile Form Event Handlers (Form Submit, Preset Avatars & Image File Upload)
  document.querySelectorAll('.profileEditForm').forEach(form => {
    // Preset buttons
    form.querySelectorAll('.preset-avatar-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const url = (e.currentTarget as HTMLElement).dataset.url;
        if (url) {
          const photoInput = form.querySelector('.inputPhotoUrl') as HTMLInputElement;
          if (photoInput) photoInput.value = url;
        }
      });
    });

    // File upload handler
    const fileInput = form.querySelector('.inputPhotoFile') as HTMLInputElement;
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.files && target.files[0]) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target?.result as string;
            const photoInput = form.querySelector('.inputPhotoUrl') as HTMLInputElement;
            if (photoInput && dataUrl) {
              photoInput.value = dataUrl;
            }
          };
          reader.readAsDataURL(target.files[0]);
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!activeUser) return;

      const submitBtn = form.querySelector('.saveProfileBtn') as HTMLButtonElement;
      const statusToast = form.querySelector('.profileStatusMsg') as HTMLElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '⏳ Guardando cambios...';
      }

      const photoURL = (form.querySelector('.inputPhotoUrl') as HTMLInputElement).value.trim();
      const displayName = (form.querySelector('.inputDisplayName') as HTMLInputElement).value.trim();
      const phone = (form.querySelector('.inputPhone') as HTMLInputElement).value.trim();
      const country = (form.querySelector('.inputCountry') as HTMLInputElement).value.trim();
      const city = (form.querySelector('.inputCity') as HTMLInputElement).value.trim();
      const description = (form.querySelector('.inputDescription') as HTMLTextAreaElement).value.trim();

      const instagram = (form.querySelector('.inputInstagram') as HTMLInputElement).value.trim();
      const linkedin = (form.querySelector('.inputLinkedin') as HTMLInputElement).value.trim();
      const twitter = (form.querySelector('.inputTwitter') as HTMLInputElement).value.trim();
      const youtube = (form.querySelector('.inputYoutube') as HTMLInputElement).value.trim();
      const website = (form.querySelector('.inputWebsite') as HTMLInputElement).value.trim();

      try {
        const updated = await updateUserProfile(activeUser.uid, {
          displayName: displayName || activeUser.displayName,
          photoURL,
          phone,
          country,
          city,
          description,
          socials: {
            instagram,
            linkedin,
            twitter,
            youtube,
            website
          }
        });

        activeUser = updated;
        setupProfileData();

        const userNameText = document.getElementById('userNameText');
        if (userNameText) userNameText.textContent = updated.displayName;

        if (statusToast) {
          statusToast.textContent = '✅ ¡Perfil actualizado con éxito!';
          statusToast.className = 'profileStatusMsg status-toast success';
          statusToast.style.display = 'inline-block';
          setTimeout(() => {
            statusToast.style.display = 'none';
          }, 3500);
        }
      } catch (err: any) {
        alert('Error al actualizar el perfil: ' + err.message);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '💾 Guardar Cambios de Perfil';
        }
      }
    });
  });

  // Client Modal
  const newReqModal = document.getElementById('newReqModal');
  document.getElementById('cOpenReqModalBtn')?.addEventListener('click', () => newReqModal?.classList.add('active'));
  document.getElementById('closeReqModal')?.addEventListener('click', () => newReqModal?.classList.remove('active'));

  document.getElementById('newReqForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!activeUser) return;

    const title = (document.getElementById('reqTitle') as HTMLInputElement).value;
    const type = (document.getElementById('reqType') as HTMLSelectElement).value as any;
    const priority = (document.getElementById('reqPriority') as HTMLSelectElement).value as any;
    const description = (document.getElementById('reqDesc') as HTMLTextAreaElement).value;

    await addRequest({
      clientId: activeUser.uid,
      clientName: activeUser.displayName,
      title,
      type,
      priority,
      description,
      status: 'pendiente',
      assignedWorker: 'Equipo Casanostra Core'
    });

    newReqModal?.classList.remove('active');
    (e.target as HTMLFormElement).reset();
    await renderClientDashboard();
  });

  // Worker Modal
  const newGoalModal = document.getElementById('newGoalModal');
  document.getElementById('wOpenGoalModalBtn')?.addEventListener('click', async () => {
    await populateClientDropdown();
    newGoalModal?.classList.add('active');
  });
  document.getElementById('closeGoalModal')?.addEventListener('click', () => newGoalModal?.classList.remove('active'));

  document.getElementById('newGoalForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const selectVal = (document.getElementById('goalClientSelect') as HTMLSelectElement).value;
    if (!selectVal) return;

    const [clientId, clientName] = selectVal.split('|');

    const title = (document.getElementById('goalTitle') as HTMLInputElement).value;
    const targetMetric = (document.getElementById('goalTargetMetric') as HTMLInputElement).value;
    const targetDate = (document.getElementById('goalTargetDate') as HTMLInputElement).value;

    await addGoal({
      clientId,
      clientName,
      title,
      targetMetric,
      currentProgress: 0,
      status: 'en_progreso',
      targetDate
    });

    newGoalModal?.classList.remove('active');
    (e.target as HTMLFormElement).reset();
    await renderWorkerDashboard();
  });
</script>
